// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
  "language_models": {
    "openai_compatible": {}
  },
  "outline_panel": {
    "button": false,
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "diff_view_style": "unified",
  "edit_predictions": {
    "provider": "none"
  },
  "agent_servers": {
    "claude-acp": {
      "default_config_options": {
        "mode": "plan",
        "effort": "high",
        "model": "opus"
      },
      "type": "registry"
    }
  },
  "colorize_brackets": true,
  "git_panel": {
    "dock": "left",
    "tree_view": true
  },
  "agent_buffer_font_size": 17.0,
  "agent": {
    "sidebar_side": "right",
    "dock": "right",
    "tool_permissions": {
      "default": "allow"
    },
    "default_profile": "write",
    "default_model": {
      "provider": "Umans AI",
      "model": "umans-glm-5.2"
    }
  },
  "vim_mode": true,
  "vim": {
    "toggle_relative_line_numbers": true
  },
  "format_on_save": "on",
  "cursor_blink": false,
  "project_panel": {
    "dock": "left",
    "sticky_scroll": false
  },
  "theme": "Catppuccin Mocha - No Italics",
  "telemetry": {
    "diagnostics": true,
    "metrics": true
  },
  "agent_ui_font_size": 20,
  "ui_font_size": 18,
  "buffer_font_size": 17.0,
  "formatter": "language_server",
  "lsp": {
    "ruby-lsp": {
      "settings": {
        "use_bundler": false
      }
    },
    "rubocop": {
      "settings": {
        "use_bundler": true
      }
    },
    "rust-analyzer": {
      "initialization_options": {
        "rust": {
          "analyzerTargetDir": true
        }
      }
    }
  },
  "languages": {
    "Ruby": {
      "language_servers": [
        "ruby-lsp",
        "rubocop",
        "!solargraph"
      ]
    }
  }
}
